# ORCA Maritime Telemetry & Emergency SOS Environment Configuration

# Next.js Public Backend API URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ==============================================================================
# TWILIO CLOUD SMS GATEWAY (Optional - For Live Server-Side Cellular SMS Dispatch)
# ==============================================================================
# Get your credentials at https://www.twilio.com/console
# 1. TWILIO_ACCOUNT_SID: Your 34-character Account SID (starts with AC...)
# 2. TWILIO_AUTH_TOKEN: Your secret Auth Token from Twilio Console
# 3. TWILIO_PHONE_NUMBER: Your Twilio E.164 phone number (e.g. +12055550199)
# NOTE for Twilio Trial Accounts:
# Twilio trial accounts can only send live SMS to phone numbers that you have
# verified under 'Verified Caller IDs' in your Twilio Console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ==============================================================================
# FAST2SMS INDIA GATEWAY (Optional - Secondary Indian Cellular SMS Provider)
# ==============================================================================
# Get API key from https://www.fast2sms.com/
FAST2SMS_API_KEY=
